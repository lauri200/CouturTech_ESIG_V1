# Base PostgreSQL (Neon, Supabase, Vercel Postgres ou locale)
DATABASE_URL=postgres://couturtech:couturtech@localhost:5432/couturtech
DATABASE_SSL=false
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5173
# Vercel envoie automatiquement "Authorization: Bearer $CRON_SECRET" aux crons
CRON_SECRET=remplacer
# E-mail (laisser vide = envoi simulé dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CouturTech <no-reply@couturtech.local>
# SMS (fournisseur à préciser ; laisser vide = envoi simulé)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=CouturTech
