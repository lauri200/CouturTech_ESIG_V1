{
  "name": "couturtech",
  "version": "1.0.0",
  "private": true,
  "description": "CouturTech – plateforme de gestion de confection de haute couture",
  "type": "commonjs",
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "db:init": "node server/scripts/db-init.js",
    "db:seed": "node server/scripts/seed.js",
    "cron": "node server/scripts/run-cron.js",
    "test": "jest --runInBand",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
